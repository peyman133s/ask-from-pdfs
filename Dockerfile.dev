# Development Dockerfile
# Includes dev dependencies (testing, linting, hot-reload helpers)
# Mounts the project directory as a volume for fast iteration

FROM docker.arvancloud.ir/python:3.10-slim

# Set working directory
WORKDIR /app

# Iran-accessible package mirrors. Override build args if you prefer another mirror.
ARG DEBIAN_MIRROR=http://mirror.arvancloud.ir/debian
ARG DEBIAN_SECURITY_MIRROR=http://mirror.arvancloud.ir/debian-security
ARG PIP_INDEX_URL=https://mirror-pypi.runflare.com/simple
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN for sources_file in /etc/apt/sources.list /etc/apt/sources.list.d/*.sources; do \
        [ -f "$sources_file" ] || continue; \
        sed -i \
            -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
            -e "s|http://security.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
            -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
            "$sources_file"; \
    done
RUN printf '%s\n' \
    'Acquire::Retries "5";' \
    'Acquire::http::Timeout "60";' \
    'Acquire::https::Timeout "60";' \
    > /etc/apt/apt.conf.d/80-retries

# Install system dependencies needed by PDF libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency file first to leverage Docker layer caching
COPY requirements.txt ./

# Install Python dependencies including dev extras
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the project
COPY . .

# Default: drop into a shell for interactive development
# Override with docker run ... python -m src.cli index
CMD ["bash"]
