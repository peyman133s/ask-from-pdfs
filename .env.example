# Environment variable template
# Copy this file to .env and fill in your values
# Never commit the real .env file

# ── Paths ─────────────────────────────────────────────────────────────────────
PDF_DIR=data/pdfs
INDEX_DIR=data/index

# ── Embedding ─────────────────────────────────────────────────────────────────
# Uses sentence-transformers locally; no API key required.
# First run: scripts/local download-embedding-model
LOCAL_EMBEDDING_MODEL=models/all-MiniLM-L6-v2
HF_HUB_OFFLINE=1
# Optional: use a Hugging Face mirror/proxy if huggingface.co is unavailable.
# HF_ENDPOINT=https://hf-mirror.com

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o
AVALAI_API_KEY=
AVALAI_API_URL=https://api.avalai.ir/v1/chat/completions
# AVALAI_TIMEOUT_SECONDS=60

# ── Local web workspace ─────────────────────────────────────────────────────
WORKSPACE_DIR=data/workspace
OCR_LANGUAGES=eng+fas
# Set SOFFICE_BIN, TESSERACT_BIN, or PDFTOPPM_BIN if a tool is outside PATH.
# TESSDATA_PREFIX=/path/to/tessdata

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=3
